#!/bin/bash
# Serialize heavy jobs on the mini (one at a time): waits for the lock, then runs the command.
# Usage: ~/boar/bin/heavy <owner> <command...>
# ONLY CPU-heavy jobs go through the lock: Gradle (assemble*), the emulator, xcodebuild,
# the full vitest suite. Downloads and installs (sdkmanager, npm/pod fetches, model copies)
# are network/disk: run them OUTSIDE the lock with nice -n 19.
# Log ~/boar/heavy.log: the old "[heavy]" lines plus "[heavyq]" lines with one id per job:
# QUEUED, START waited=<s>, END rc=<n> ran=<s>. Queue owner: Harbor. Stats: ~/boar/bin/heavy-stats [minutes]
# Priority: HEAVY_CLASS=short (job < 5 min, e.g. an e2e flow) goes ahead of any waiting
# HEAVY_CLASS=gate job: a gate does not take the lock while a short job is waiting.
# Gates run in batches: at most 1 per hour (Boar, 27/09), except safety blockers.
owner="$1"; shift
CMD=("$@")
class="${HEAVY_CLASS:-normal}"; export HEAVY_CLASS="$class"
qd=~/boar/.heavy-short; mkdir -p "$qd"
id="$(date +%s)-$$"
q=$(date +%s)
echo "[heavy] $(date +%H:%M:%S) $owner waiting for lock" >> ~/boar/heavy.log
echo "[heavyq] $(date '+%F %T') id=$id owner=$owner class=$class QUEUED" >> ~/boar/heavy.log
if [[ "$class" == short ]]; then touch "$qd/$id"; trap 'rm -f "$qd/$id"' EXIT; fi
shorts() { [[ -n "$(find "$qd" -type f -mmin -30 2>/dev/null | head -1)" ]]; }
run() { /usr/bin/lockf -k ${1:+-t "$1"} ~/boar/.heavy.lock /bin/bash -c '
  id=$1; owner=$2; q=$3; shift 3
  # a gate that got the lock while a short job waits hands it back (76) and retries
  if [ "$HEAVY_CLASS" = gate ] && [ -n "$(find ~/boar/.heavy-short -type f -mmin -30 2>/dev/null | head -1)" ]; then exit 76; fi
  s=$(date +%s)
  echo "[heavy] $(date +%H:%M:%S) $owner START: $*" >> ~/boar/heavy.log
  echo "[heavyq] $(date "+%F %T") id=$id owner=$owner START waited=$((s - q))s" >> ~/boar/heavy.log
  rm -f ~/boar/.heavy-short/"$id"
  "$@"; rc=$?
  e=$(date +%s)
  echo "[heavy] $(date +%H:%M:%S) $owner END rc=$rc" >> ~/boar/heavy.log
  echo "[heavyq] $(date "+%F %T") id=$id owner=$owner END rc=$rc ran=$((e - s))s" >> ~/boar/heavy.log
  exit $rc' _ "$id" "$owner" "$q" "${CMD[@]}"; }
if [[ "$class" == gate ]]; then
  # A gate only takes the lock when no short job is waiting; it retries every 5 s,
  # so a short job queued while the gate waits still goes first (stale markers > 30 min ignored).
  while :; do
    while shorts; do sleep 5; done
    run 5; rc=$?; [[ $rc == 75 || $rc == 76 ]] || exit $rc
  done
fi
run
